---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header {...headerData} actions={[]} isSticky />
  </Fragment>
  <Hero2 tagline={hero.tagline} actions={hero.actions} image={hero.image}>
    <Fragment slot="title">{hero.title}</Fragment>
    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Elevate your website creation process with <span class="font-semibold">AstroWind</span>'s SaaS solutions.</span
      >
      Seamlessly blend the power of Astro 5.0 and Tailwind CSS to craft websites that resonate with your brand and audience.
    </Fragment>
  </Hero2>
  <Features id={why.id} title={why.title} subtitle={why.subtitle} columns={why.columns} items={why.items} />
  <Content title={details.title} subtitle={details.subtitle} items={details.items} image={details.image} />
  <Pricing title={pricing.title} prices={pricing.prices} />
  <FAQs title={faq.title} items={faq.items} />
</Layout>
